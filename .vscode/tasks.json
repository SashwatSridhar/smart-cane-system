{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "source ros2",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash && source install/setup.bash",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "colcon build",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash && colcon build && source install/setup.bash",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "run camera node",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 run smart_cane_system camera_node",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            }
        },
        {
            "label": "run all nodes",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash && source install/setup.bash && ./launch_smart_cane.sh",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            }
        }
    ]
}
